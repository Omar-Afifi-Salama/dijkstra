---
// src/components/LanguageSelector.astro
import { supportedLocales, translations } from "../i18n/utils";

interface Props {
    locale: string;
}

const { locale } = Astro.props;

// Calculate current pathname and strip the active locale prefix
const currentPath = Astro.url.pathname;
const pathSegments = currentPath.split("/").filter(Boolean);

// Replace or prefix the first segment with target locale
function getLocalizedPath(targetLocale: string): string {
    if (pathSegments.length === 0) return `/${targetLocale}`;
    const segmentsCopy = [...pathSegments];
    if (supportedLocales.includes(segmentsCopy[0])) {
        segmentsCopy[0] = targetLocale;
    } else {
        segmentsCopy.unshift(targetLocale);
    }
    return `/${segmentsCopy.join("/")}`;
}
---

<div class="lang-selector">
    <select
        id="locale-switch"
        aria-label="Select Language"
        onchange="window.location.href = this.value"
    >
        {
            supportedLocales.map((loc) => (
                <option value={getLocalizedPath(loc)} selected={loc === locale}>
                    {translations[loc]?.name || loc.toUpperCase()}
                </option>
            ))
        }
    </select>

    <!-- Custom dropdown arrow -->
    <span class="select-arrow" aria-hidden="true">▾</span>
</div>

<style>
    .lang-selector {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        background-color: var(--bg-surface);
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm, 6px);
        padding-block: 0.375rem;
        padding-inline: 0.75rem 1.75rem;
        font-size: var(--text-xs, 0.75rem);
        font-weight: 500;
        cursor: pointer;
        outline: none;
        transition:
            background-color 120ms ease,
            border-color 120ms ease,
            color 120ms ease;
    }

    select:hover {
        background-color: var(--bg-surface-hover);
        border-color: var(--border-strong);
        color: var(--text-primary);
    }

    select:focus-visible {
        border-color: var(--accent);
    }

    .select-arrow {
        position: absolute;
        inset-inline-end: 0.6rem;
        pointer-events: none;
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    /* Ensure options match dark mode surface styling */
    option {
        background-color: var(--bg-surface);
        color: var(--text-primary);
    }
</style>
