---
// src/pages/404.astro
import GlobalLayout from "@/layouts/GlobalLayout.astro";
import { useTranslations } from "@/i18n/utils";

// Default static fallback for build time
const defaultLocale = "en";
const { t } = useTranslations(defaultLocale);
---

<GlobalLayout
    title={`dijkstra_ | ${t("notFound.code")} - ${t("notFound.title")}`}
    locale={defaultLocale}
    description={t("notFound.description")}
>
    <main class="not-found-page">
        <div class="not-found-card">
            <div class="status-badge">
                <span class="pulse-dot" aria-hidden="true"></span>
                <span class="status-code">{t("notFound.code")}</span>
            </div>

            <h1 class="error-title">{t("notFound.title")}</h1>
            <p class="error-desc">{t("notFound.description")}</p>

            <div class="action-buttons">
                <a href={`/${defaultLocale}`} class="btn-primary home-link">
                    <span>{t("notFound.backHome")}</span>
                </a>
                <a
                    href={`/${defaultLocale}/languages`}
                    class="btn-secondary tracks-link"
                >
                    <span>{t("notFound.exploreTracks")}</span>
                    <span class="btn-arrow" aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </div>
    </main>
</GlobalLayout>

<style>
    .not-found-page {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding-inline: var(--space-4, 1rem);
        padding-block: var(--space-12, 3rem);
    }

    .not-found-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg, 16px);
        padding: var(--space-8, 2rem);
        max-width: 520px;
        width: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4, 1rem);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2, 0.5rem);
        background: var(--accent-subtle);
        border: 1px solid var(--accent);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
    }

    .status-code {
        font-family: var(--font-mono, monospace);
        font-size: var(--text-sm, 0.875rem);
        font-weight: 700;
        color: var(--accent);
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        animation: pulse 1.5s ease-in-out infinite;
    }

    .error-title {
        font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }

    .error-desc {
        font-size: var(--text-sm, 0.875rem);
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 44ch;
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--space-3, 0.75rem);
        margin-block-start: var(--space-2, 0.5rem);
        width: 100%;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--accent);
        color: #ffffff;
        font-size: var(--text-sm, 0.875rem);
        font-weight: 600;
        padding: 0.6rem 1.25rem;
        border-radius: var(--radius-sm, 6px);
        text-decoration: none;
        transition:
            background-color 120ms ease,
            transform 120ms ease;
    }

    .btn-primary:hover {
        background-color: var(--accent-hover);
        transform: translateY(-1px);
    }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2, 0.5rem);
        background-color: var(--bg-surface-subtle);
        color: var(--text-primary);
        border: 1px solid var(--border-subtle);
        font-size: var(--text-sm, 0.875rem);
        font-weight: 500;
        padding: 0.6rem 1.25rem;
        border-radius: var(--radius-sm, 6px);
        text-decoration: none;
        transition:
            background-color 120ms ease,
            border-color 120ms ease;
    }

    .btn-secondary:hover {
        background-color: var(--bg-surface-hover);
        border-color: var(--border-strong);
    }

    .btn-arrow {
        display: inline-block;
        transition: transform 120ms ease;
    }

    :global([dir="ltr"]) .btn-secondary:hover .btn-arrow {
        transform: translateX(3px);
    }

    :global([dir="rtl"]) .btn-arrow {
        transform: rotate(180deg);
    }

    :global([dir="rtl"]) .btn-secondary:hover .btn-arrow {
        transform: rotate(180deg) translateX(3px);
    }

    @keyframes pulse {
        0%,
        100% {
            opacity: 0.4;
            transform: scale(0.9);
        }
        50% {
            opacity: 1;
            transform: scale(1.2);
        }
    }
</style>

<!-- Client-side locale adaptation script -->
<script>
    function adaptLocale() {
        // Determine active locale from current URL (e.g. /ar/python/xyz) or stored preference
        const path = window.location.pathname;
        const isArabic =
            path.startsWith("/ar") ||
            localStorage.getItem("dijkstra_preferred_locale") === "ar";
        const currentLocale = isArabic ? "ar" : "en";

        // Update root language & direction if Arabic is detected
        if (isArabic) {
            document.documentElement.setAttribute("lang", "ar");
            document.documentElement.setAttribute("dir", "rtl");

            // Update CTA links to point to /ar
            const homeLink =
                document.querySelector<HTMLAnchorElement>(".home-link");
            const tracksLink =
                document.querySelector<HTMLAnchorElement>(".tracks-link");

            if (homeLink) homeLink.href = "/ar";
            if (tracksLink) tracksLink.href = "/ar/languages";
        }
    }

    adaptLocale();
    document.addEventListener("astro:after-swap", adaptLocale);
</script>
