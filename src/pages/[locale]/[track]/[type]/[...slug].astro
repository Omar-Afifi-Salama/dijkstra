---
// src/pages/[locale]/[track]/[type]/[...slug].astro
import { render } from "astro:content";
import { getNavigation } from "@/utils/navigation";
import { useTranslations } from "@/i18n/utils";
import { getAllCurriculumEntries } from "@/utils/routes";
import { createItemKey } from "@/stores/userStore";
import type { Track, ContentType } from "@/data/roadmaps";
import GlobalLayout from "@/layouts/GlobalLayout.astro";
import NavIsland from "@/components/NavIsland.astro";
import BookmarkButton from "@/components/BookmarkButton";

export async function getStaticPaths() {
    const allItems = await getAllCurriculumEntries();

    return allItems.map((entry) => {
        const [locale, track, type, ...slugParts] = entry.id
            .replace(/\.mdx?$/, "")
            .split("/");
        return {
            params: {
                locale,
                track,
                type,
                slug: slugParts.join("/"),
            },
            props: { entry },
        };
    });
}

const { locale, track, type, slug } = Astro.params;
const { entry } = Astro.props;

const { Content } = await render(entry);
const { t } = useTranslations(locale);

const nav = await getNavigation(
    locale,
    track as Track,
    type as ContentType,
    slug,
    "collection",
);

const trackCapitalized = track.charAt(0).toUpperCase() + track.slice(1);
const typeFormatted = type.charAt(0).toUpperCase() + type.slice(1);
const itemKey = createItemKey(track, type, slug);

// Safely format estimated time using i18n interpolation
const formattedDuration = (entry as any).data.estimatedMinutes
    ? t("units.estimatedMinutes", {
          minutes: (entry as any).data.estimatedMinutes,
      })
    : null;

const bookmarkLabels = {
    bookmark: t("actions.bookmark") || "Bookmark",
    bookmarked: t("actions.bookmarked") || "Saved",
};
---

<GlobalLayout
    title={`dijkstra_ | ${entry.data.title} (${trackCapitalized})`}
    locale={locale}
    description={entry.data.description || t("landing.subtitle")}
    canonicalUrl={`/${locale}/${track}/${type}/${slug}`}
>
    <main class="content-container">
        <!-- Top Breadcrumb Link -->
        <a href={`/${locale}/${track}/${type}`} class="back-link">
            <svg
                class="back-icon"
                viewBox="0 0 24 24"
                width="16"
                height="16"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
            >
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span
                >{
                    t("nav.backToParent", {
                        parent: t(`sections.${type}`) || typeFormatted,
                    }) || `Back to ${typeFormatted}`
                }</span
            >
        </a>

        <!-- Article Header -->
        <article class="article-wrapper">
            <header class="article-header">
                <div class="header-meta">
                    <span class={`type-badge badge-${type}`}>
                        {t(`sections.${type}`) || type}
                    </span>
                    <span class="track-pill">{trackCapitalized}</span>
                    {
                        formattedDuration && (
                            <span class="duration-pill">
                                {formattedDuration}
                            </span>
                        )
                    }

                    <!-- Top Bookmark Action Button -->
                    <div class="meta-actions">
                        <BookmarkButton
                            client:load
                            itemKey={itemKey}
                            labels={bookmarkLabels}
                        />
                    </div>
                </div>

                <h1 class="article-title">{entry.data.title}</h1>
                {
                    entry.data.description && (
                        <p class="article-lead">{entry.data.description}</p>
                    )
                }
            </header>

            <!-- Rendered Markdown / MDX Body -->
            <div class="prose-content">
                <Content />
            </div>
        </article>

        <!-- Bottom Navigation Island in Collection Mode -->
        <NavIsland
            nav={nav}
            context="collection"
            track={track}
            type={type}
            slug={slug}
            locale={locale}
        />
    </main>
</GlobalLayout>

<style>
    .content-container {
        max-width: 1100px;
        margin-inline: auto;
        padding-inline: var(--space-4, 1rem);
        padding-block: var(--space-6, 1.5rem) var(--space-16, 4rem);
    }

    /* Back Link */
    .back-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2, 0.5rem);
        font-size: var(--text-xs, 0.75rem);
        font-family: var(--font-mono, monospace);
        font-weight: 500;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.35rem 0.6rem;
        margin-inline-start: -0.6rem;
        border-radius: var(--radius-sm, 6px);
        transition:
            color 120ms ease,
            background-color 120ms ease;
        margin-block-end: var(--space-6, 1.5rem);
    }

    .back-link:hover {
        color: var(--text-primary);
        background-color: var(--bg-surface-hover);
    }

    .back-icon {
        flex-shrink: 0;
        transition: transform 150ms ease;
    }

    :global([dir="ltr"]) .back-link:hover .back-icon {
        transform: translateX(-3px);
    }

    :global([dir="rtl"]) .back-icon {
        transform: rotate(180deg);
    }

    :global([dir="rtl"]) .back-link:hover .back-icon {
        transform: rotate(180deg) translateX(-3px);
    }

    /* Header */
    .article-header {
        margin-block-end: var(--space-8, 2rem);
        padding-block-end: var(--space-6, 1.5rem);
        border-block-end: 1px solid var(--border-subtle);
    }

    .header-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2, 0.5rem);
        margin-block-end: var(--space-3, 0.75rem);
    }

    .meta-actions {
        margin-inline-start: auto;
        display: flex;
        align-items: center;
    }

    .type-badge {
        font-size: var(--text-xs, 0.75rem);
        font-family: var(--font-mono, monospace);
        text-transform: uppercase;
        font-weight: 700;
        padding: 0.15rem 0.5rem;
        border-radius: var(--radius-sm, 6px);
    }

    .badge-lessons {
        background: var(--accent-subtle);
        color: var(--accent);
    }

    .badge-challenges {
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
    }

    .badge-projects {
        background: rgba(245, 158, 11, 0.12);
        color: #f59e0b;
    }

    .track-pill,
    .duration-pill {
        font-size: var(--text-xs, 0.75rem);
        font-family: var(--font-mono, monospace);
        color: var(--text-muted);
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        padding: 0.15rem 0.5rem;
        border-radius: var(--radius-sm, 6px);
    }

    /* Top Bookmark Button Styles */
    :global(.header-bookmark-btn) {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.25rem 0.6rem;
        font-size: var(--text-xs, 0.75rem);
        font-family: var(--font-mono, monospace);
        font-weight: 600;
        background-color: var(--bg-surface);
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm, 6px);
        cursor: pointer;
        transition:
            background-color 120ms ease,
            border-color 120ms ease,
            color 120ms ease;
    }

    :global(.header-bookmark-btn:hover) {
        background-color: var(--bg-surface-hover);
        color: var(--text-primary);
        border-color: var(--border-strong, #334155);
    }

    :global(.header-bookmark-btn.is-bookmarked) {
        background-color: rgba(168, 85, 247, 0.12);
        border-color: rgba(168, 85, 247, 0.35);
        color: #c084fc;
    }

    :global(:root[data-theme="light"] .header-bookmark-btn.is-bookmarked) {
        background-color: rgba(147, 51, 234, 0.1);
        border-color: rgba(147, 51, 234, 0.35);
        color: #7e22ce;
    }

    :global(.header-bookmark-btn .bookmark-svg) {
        flex-shrink: 0;
        transition: transform 120ms ease;
    }

    :global(.header-bookmark-btn:hover .bookmark-svg) {
        transform: scale(1.15);
    }

    .article-title {
        font-size: clamp(1.75rem, 1.35rem + 1.5vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text-primary);
        line-height: 1.25;
        margin-block-end: var(--space-2, 0.5rem);
    }

    .article-lead {
        font-size: var(--text-base, 1rem);
        color: var(--text-secondary);
        line-height: 1.6;
        margin-block-start: var(--space-2, 0.5rem);
    }

    /* Prose Content */
    .prose-content {
        font-size: var(--text-base, 1rem);
        line-height: 1.75;
        color: var(--text-primary);
    }

    .prose-content :global(h2) {
        font-size: var(--text-xl, 1.35rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-block: var(--space-8, 2rem) var(--space-3, 0.75rem);
        color: var(--text-primary);
    }

    .prose-content :global(h3) {
        font-size: var(--text-lg, 1.125rem);
        font-weight: 600;
        margin-block: var(--space-6, 1.5rem) var(--space-2, 0.5rem);
        color: var(--text-primary);
    }

    .prose-content :global(p) {
        margin-block-end: var(--space-4, 1rem);
        color: var(--text-secondary);
    }

    .prose-content :global(ul),
    .prose-content :global(ol) {
        margin-block-end: var(--space-4, 1rem);
        padding-inline-start: var(--space-6, 1.5rem);
        color: var(--text-secondary);
    }

    .prose-content :global(li) {
        margin-block-end: var(--space-1, 0.25rem);
    }

    .prose-content :global(blockquote) {
        border-inline-start: 3px solid var(--accent);
        padding-inline-start: var(--space-4, 1rem);
        margin-inline: 0;
        margin-block: var(--space-6, 1.5rem);
        color: var(--text-secondary);
        font-style: italic;
        background: var(--bg-surface-subtle);
        padding-block: var(--space-3, 0.75rem);
        border-radius: 0 var(--radius-sm, 6px) var(--radius-sm, 6px) 0;
    }

    :global([dir="rtl"]) .prose-content :global(blockquote) {
        border-radius: var(--radius-sm, 6px) 0 0 var(--radius-sm, 6px);
    }

    .prose-content :global(code:not(pre code)) {
        font-family: var(--font-mono, monospace);
        font-size: 0.875em;
        background: var(--bg-surface-subtle);
        border: 1px solid var(--border-subtle);
        padding: 0.15rem 0.35rem;
        border-radius: var(--radius-sm, 4px);
        color: var(--text-primary);
    }

    .prose-content :global(pre) {
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md, 10px);
        padding: var(--space-4, 1rem);
        margin-block: var(--space-6, 1.5rem);
        overflow-x: auto;
    }

    .prose-content :global(a) {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .prose-content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: var(--radius-md, 10px);
        border: 1px solid var(--border-subtle);
        margin-block: var(--space-6, 1.5rem);
    }
</style>
